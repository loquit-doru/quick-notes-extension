{
  "manifest_version": 3,
  "name": "Quick Notes: Offline Notepad & Note Taking, No Account",
  "short_name": "Quick Notes",
  "version": "1.7.2",
  "description": "Fast notepad for any tab. No account, no cloud, no tracking. Free core plan plus an optional one-time Pro unlock.",
  "author": "Quick Notes Team",
  "icons": {
    "16": "icons/qn-16.png",
    "32": "icons/qn-32.png",
    "48": "icons/qn-48.png",
    "128": "icons/qn-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/qn-16.png",
      "32": "icons/qn-32.png",
      "48": "icons/qn-48.png"
    },
    "default_title": "Quick Notes (Ctrl+Shift+Q)"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "Open Quick Notes"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://extensionpay.com/*"
      ],
      "js": [
        "lib/ExtPay.js"
      ],
      "run_at": "document_start"
    }
  ]
}

